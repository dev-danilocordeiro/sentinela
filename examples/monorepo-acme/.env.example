# .env.example do cenário acme (modo completo). Copie para .env ao lado do sentinela.yaml e
# preencha. Nunca commite o .env. Os nomes das variáveis são os que o Sentinela lê (docs/configuracao.md).

# Postgres (docker compose do Sentinela)
DATABASE_URL=postgres://sentinela:sentinela@localhost:5432/sentinela?sslmode=disable

# Linear: app OAuth do Sentinela (rode `sentinela linear auth` uma vez depois de preencher)
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=

# Slack: bot do Sentinela (convide-o em #sentinela e nos canais dos times)
SLACK_BOT_TOKEN=

# GitHub: leitura dos clones e as duas GitHub Apps
GITHUB_TOKEN=
GITHUB_BOT_APP_ID=
GITHUB_BOT_INSTALLATION_ID=
GITHUB_BOT_PRIVATE_KEY_PATH=./secrets/sentinela-bot.private-key.pem
GITHUB_REVIEWER_APP_ID=
GITHUB_REVIEWER_INSTALLATION_ID=
GITHUB_REVIEWER_PRIVATE_KEY_PATH=./secrets/sentinela-reviewer.private-key.pem
