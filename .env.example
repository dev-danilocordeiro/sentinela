# Copie para .env e preencha. Nunca commite o .env.

# Anthropic (Console > API Keys). Necessário para Batch API e prompt caching.
ANTHROPIC_API_KEY=
# Só se a chave não for de um workspace: ID do workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=

# Linear (Settings > Security & access > Personal API keys), com acesso ao workspace configurado
# LINEAR_API_KEY=                  # opcional: só com linear_auth.mode api_key ou fallback_api_key
LINEAR_WEBHOOK_SECRET=            # só no modo webhook
# App OAuth do Sentinela no Linear (linear_auth, ADR 0032): as ações saem como o app, não como
# a dona da LINEAR_API_KEY. Depois de preencher, rode `sentinela linear auth` uma vez.
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=

# Slack app do Sentinela (manifest em docs/manifests/slack-app-manifest.yaml); os canais ficam no sentinela.yaml
SLACK_BOT_TOKEN=                  # xoxb-...

# GitHub App que abre PRs (manifest em docs/manifests/github-app-bot.json)
GITHUB_BOT_APP_ID=
GITHUB_BOT_PRIVATE_KEY_PATH=./secrets/sentinela-bot.private-key.pem
GITHUB_BOT_INSTALLATION_ID=

# GitHub App revisora (manifest em docs/manifests/github-app-reviewer.json)
GITHUB_REVIEWER_APP_ID=
GITHUB_REVIEWER_PRIVATE_KEY_PATH=./secrets/sentinela-reviewer.private-key.pem
GITHUB_REVIEWER_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Postgres (docker compose)
DATABASE_URL=postgres://sentinela:sentinela@localhost:5432/sentinela?sslmode=disable

# Fase 5
SENTRY_AUTH_TOKEN=
DD_API_KEY=
DD_APP_KEY=

# GitHub na Fase 1 (config validate/bootstrap, owners explain): token só de leitura.
# As GitHub Apps acima substituem este token a partir da Fase 4.
GITHUB_TOKEN=

# Overrides opcionais (testes e proxies)
# LINEAR_API_URL=https://api.linear.app/graphql
# GITHUB_API_URL=https://api.github.com

# Testes de integração do store: banco descartável (o teste derruba e recria o schema)
# Use um banco só para testes: crie com `docker compose exec postgres createdb -U sentinela sentinela_test`
# SENTINELA_TEST_DATABASE_URL=postgres://sentinela:sentinela@localhost:5432/sentinela_test?sslmode=disable
